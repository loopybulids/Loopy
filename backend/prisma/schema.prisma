// Loopy data model — based on PRD §13.
// Postgres (Neon). Amounts are stored as integer rupees to keep money math exact.
//
// The JSON-ish columns (`images`, `variants`, `sizes`, `storeConfig`) are still
// String-encoded JSON rather than native `Json`. That's deliberate for now — the
// app code reads/writes them with JSON.parse/stringify everywhere, so switching
// the column type is a separate change with its own data backfill.

generator client {
  provider      = "prisma-client-js"
  // "native" = local dev; the rhel targets are for Vercel's Linux runtime.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled (PgBouncer) endpoint — used by the running app.
  url       = env("DATABASE_URL")
  // Unpooled endpoint — Prisma needs a direct connection for schema changes
  // (`db push` / `migrate`), which don't work through a transaction pooler.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?  @unique
  password  String?  // bcrypt hash — set for email/password sellers
  role      String   @default("buyer") // buyer | seller | admin
  createdAt DateTime @default(now())

  seller       Seller?
  ordersBought Order[] @relation("BuyerOrders")
}

model Seller {
  id          String   @id @default(cuid())
  userId      String   @unique
  storeName   String
  username    String   @unique
  description String?
  bannerUrl   String?
  logoUrl     String?
  rating      Float    @default(0)
  ratingCount Int      @default(0)
  city        String?
  address     String?  // pickup / business address
  // public profile
  category        String?  // store niche, e.g. "Vintage & Thrift"
  tagline         String?  // short one-liner
  contactPhone    String?  // public contact number
  contactEmail    String?  // public contact email
  instagram       String?
  whatsapp        String?
  establishedYear Int?
  kycStatus   String   @default("approved") // pending | approved | rejected
  storeConfig String?  // JSON string — storefront builder config (sections, theme, hero…)
  published   Boolean  @default(false) // store is live once the seller publishes
  // payout details
  payoutEmail   String?
  payoutMethod  String? // upi | bank
  payoutUpi     String?
  payoutAccount String?
  payoutName    String?
  payoutPhone   String?
  // shipping settings
  shippingFee       Int?     // flat shipping charge per order (rupees)
  minOrderAmount    Int?     // minimum cart subtotal required to check out
  shipDays          Int?     // estimated days to dispatch (shown on product pages)
  freeShipEnabled   Boolean  @default(false)
  freeShipThreshold Int?     // orders above this ship free (when enabled)
  expressShip       Boolean  @default(false)
  expressFee        Int?     // premium express-shipping fee
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  products  Product[]
  orders    Order[]
  visits    Visit[]
  customers Customer[]
}

// Per-store shopper account (a customer signs up separately for each store).
model Customer {
  id        String   @id @default(cuid())
  sellerId  String
  email     String?
  name      String?
  phone     String?
  password  String?  // bcrypt hash — null for Google-only shoppers
  createdAt DateTime @default(now())

  seller    Seller         @relation(fields: [sellerId], references: [id])
  addresses Address[]
  wishlist  WishlistItem[]

  @@unique([sellerId, email])
  @@index([sellerId])
}

// A shopper who entered email + password but hasn't typed their 6-digit code
// yet. Nothing is written to Customer until the code checks out, so an
// unverified email can never occupy an account.
//
// This lives in the DB rather than in memory so codes survive a backend restart
// and still work when more than one instance is running.
model PendingSignup {
  id           String   @id @default(cuid())
  sellerId     String
  email        String
  name         String?
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([sellerId, email])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, productId])
  @@index([customerId])
}

// Seller notifications (new customer, new order…).
model Notification {
  id        String   @id @default(cuid())
  sellerId  String
  type      String   // new_customer | new_order
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sellerId])
}

// Lightweight storefront traffic — one row per page view (deduped by session).
model Visit {
  id        String   @id @default(cuid())
  sellerId  String
  session   String?
  source    String?  // Instagram | WhatsApp | Google | Direct | …
  referrer  String?  // raw referrer URL for detail
  createdAt DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([createdAt])
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  title       String
  slug        String
  description String?
  price       Int // selling price (rupees)
  mrp         Int? // market / compare-at price — shown struck-through when higher
  condition   String   @default("Good") // Like new | Good | Fair
  size        String?
  brand       String?
  category    String?
  images      String   @default("[]") // JSON array of URLs (string for SQLite)
  variants    String   @default("[]") // JSON array of { label, price?, stock? }
  sizes       String   @default("[]") // JSON array of available sizes (XS…XXXL)
  sizeChartUrl String? // uploaded size-chart image
  quantity    Int      @default(1) // one-of-one items default to 1
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  seller     Seller      @relation(fields: [sellerId], references: [id])
  orderItems OrderItem[]

  @@index([sellerId])
}

model Order {
  id               String   @id @default(cuid())
  buyerId          String?
  customerId       String?
  sellerId         String
  buyerName        String?
  buyerPhone       String?
  address          String?
  totalAmount      Int
  itemsAmount      Int
  commissionAmount Int
  shippingCharge   Int
  /// Coupon discount off the goods value, borne by the seller. The platform
  /// fee is charged on itemsAmount - discountAmount, so a discounted order
  /// still reconciles. See common/money.
  discountAmount   Int      @default(0)
  /// The code the buyer actually used, kept for support and reporting.
  couponCode       String?
  // PendingPayment | Paid | Accepted | Shipped | Delivered | Completed
  // | Cancelled | Disputed | Refunded
  status           String   @default("PendingPayment")
  razorpayOrderId  String?
  paymentId        String?
  awbNumber        String?
  courier          String?  // shipping agency, captured when the seller ships
  cancelReason     String?  // why it was cancelled — shown to the other party
  // 'buyer' | 'seller'. Both paths set status='Cancelled', so without this the
  // seller can't tell a customer cancellation from their own rejection.
  cancelledBy      String?
  // Optimistic-lock counter. Every money-affecting write must supply the
  // version it read; the update matches on it and bumps it, so a second
  // click — or a second operator working from a stale screen — is rejected
  // instead of silently applying the same action twice.
  version          Int      @default(0)
  // Refund lifecycle, tracked separately from `status` because "this order
  // owes a refund" and "the money has actually gone back" are different facts.
  // null (nothing owed) | Required | Initiated | Refunded | Failed
  refundState      String?
  createdAt        DateTime @default(now())

  buyer  User?       @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller Seller      @relation(fields: [sellerId], references: [id])
  items  OrderItem[]

  @@index([sellerId])
  @@index([buyerId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  title     String
  unitPrice Int
  quantity  Int    @default(1)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// A buyer's rating of one order.
///
/// Visibility is a three-level hierarchy:
///   buyer   writes it
///   seller  may hide it from their storefront (and reply to it)
///   admin   sees every review, hidden or not, and who hid it
///
/// `hidden` only removes it from public view — nothing deletes a review, so a
/// seller cannot quietly erase criticism, only stop displaying it.
model Review {
  id           String    @id @default(cuid())
  orderId      String
  productId    String
  sellerId     String
  /// Who wrote it, when the buyer was a signed-in store customer.
  customerId   String?
  buyerName    String?
  rating       Int
  comment      String?
  response     String?   // seller's public reply
  respondedAt  DateTime?
  /// Hidden from the storefront by the seller. Still visible to them and admin.
  hidden       Boolean   @default(false)
  hiddenReason String?
  hiddenAt     DateTime?
  createdAt    DateTime  @default(now())

  /// One review per order — the buyer rates the order once.
  @@unique([orderId])
  @@index([sellerId])
  @@index([productId])
  @@index([customerId])
}

model Dispute {
  id          String    @id @default(cuid())
  orderId     String
  sellerId    String
  buyerName   String?
  issueType   String    @default("Not as described")
  description String?
  status      String    @default("open") // open | refunded | released
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status])
}

/// One row per successful coupon use, so per-customer limits can be enforced
/// and a redemption can be traced back to its order.
model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  sellerId   String
  customerId String?
  orderId    String
  amount     Int
  createdAt  DateTime @default(now())

  @@index([couponId])
  @@index([couponId, customerId])
  @@index([orderId])
}

model Coupon {
  id               String    @id @default(cuid())
  sellerId         String
  code             String
  type             String    @default("percent") // percent | fixed
  value            Int
  maxDiscount      Int? // cap on a percentage discount
  minOrder         Int       @default(0)
  usageLimit       Int? // total redemptions allowed (null = unlimited)
  perCustomerLimit Int? // redemptions per customer (null = unlimited)
  usedCount        Int       @default(0)
  startsAt         DateTime?
  expiresAt        DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@unique([sellerId, code])
  @@index([sellerId])
}

/// A seller's withdrawal request and its decision.
///
/// requested -> paid      admin approved and money was sent
/// requested -> rejected  admin declined; the amount returns to available
///
/// Nothing ever set `paid` before: sellers could request a payout but no
/// approval path existed, so every request sat as `requested` forever and the
/// seller's "Settled" total was permanently zero.
model Payout {
  id        String   @id @default(cuid())
  sellerId  String
  amount    Int
  status    String   @default("requested") // requested | paid | rejected
  /// Optimistic-lock counter — an approval must name the version it saw, so a
  /// double click cannot pay the same request twice. See common/money-actions.
  version   Int      @default(0)
  /// Why it was rejected, or the transfer reference when paid.
  note      String?
  /// Who decided, and when.
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime @default(now())

  @@index([sellerId])
  @@index([status])
}

/// One row per completed money action, keyed by the caller's Idempotency-Key.
/// A retry — a double click, a flaky network, a browser replaying the request —
/// arrives with the same key, finds this row, and gets the original response
/// back instead of performing the action a second time.
model IdempotencyKey {
  key       String   @id
  scope     String
  actorId   String
  target    String
  response  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Append-only record of who moved money and what it looked like before.
/// Nothing in the codebase updates or deletes these rows — that is the point.
/// When a figure is disputed this is the only evidence of how it got that way.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String?
  action     String
  entity     String
  entityId   String
  before     String?
  after      String?
  amount     Int?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
