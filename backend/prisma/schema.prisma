// Loopy data model — based on PRD §13.
// Dev uses SQLite for zero-infra local runs. To go to Postgres (PRD spec):
//   1. change provider below to "postgresql"
//   2. set DATABASE_URL to your Postgres connection string
//   3. (optional) convert the JSON-string `images` field to Json and the
//      status/role/condition strings to native enums.
// Amounts are stored as integer rupees to keep money math exact.

generator client {
  provider      = "prisma-client-js"
  // "native" = local dev; the rhel targets are for Vercel's Linux runtime.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?  @unique
  password  String?  // bcrypt hash — set for email/password sellers
  role      String   @default("buyer") // buyer | seller | admin
  createdAt DateTime @default(now())

  seller       Seller?
  ordersBought Order[] @relation("BuyerOrders")
}

model Seller {
  id          String   @id @default(cuid())
  userId      String   @unique
  storeName   String
  username    String   @unique
  description String?
  bannerUrl   String?
  logoUrl     String?
  rating      Float    @default(0)
  ratingCount Int      @default(0)
  city        String?
  address     String?  // pickup / business address
  // public profile
  category        String?  // store niche, e.g. "Vintage & Thrift"
  tagline         String?  // short one-liner
  contactPhone    String?  // public contact number
  contactEmail    String?  // public contact email
  instagram       String?
  whatsapp        String?
  establishedYear Int?
  kycStatus   String   @default("approved") // pending | approved | rejected
  storeConfig String?  // JSON string — storefront builder config (sections, theme, hero…)
  published   Boolean  @default(false) // store is live once the seller publishes
  // payout details
  payoutEmail   String?
  payoutMethod  String? // upi | bank
  payoutUpi     String?
  payoutAccount String?
  payoutName    String?
  payoutPhone   String?
  // shipping settings
  shippingFee       Int?     // flat shipping charge per order (rupees)
  minOrderAmount    Int?     // minimum cart subtotal required to check out
  shipDays          Int?     // estimated days to dispatch (shown on product pages)
  freeShipEnabled   Boolean  @default(false)
  freeShipThreshold Int?     // orders above this ship free (when enabled)
  expressShip       Boolean  @default(false)
  expressFee        Int?     // premium express-shipping fee
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  products  Product[]
  orders    Order[]
  visits    Visit[]
  customers Customer[]
}

// Per-store shopper account (a customer signs up separately for each store).
model Customer {
  id        String   @id @default(cuid())
  sellerId  String
  email     String?
  name      String?
  phone     String?
  createdAt DateTime @default(now())

  seller    Seller         @relation(fields: [sellerId], references: [id])
  addresses Address[]
  wishlist  WishlistItem[]

  @@unique([sellerId, email])
  @@index([sellerId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, productId])
  @@index([customerId])
}

// Seller notifications (new customer, new order…).
model Notification {
  id        String   @id @default(cuid())
  sellerId  String
  type      String   // new_customer | new_order
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sellerId])
}

// Lightweight storefront traffic — one row per page view (deduped by session).
model Visit {
  id        String   @id @default(cuid())
  sellerId  String
  session   String?
  source    String?  // Instagram | WhatsApp | Google | Direct | …
  referrer  String?  // raw referrer URL for detail
  createdAt DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([createdAt])
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  title       String
  slug        String
  description String?
  price       Int // selling price (rupees)
  mrp         Int? // market / compare-at price — shown struck-through when higher
  condition   String   @default("Good") // Like new | Good | Fair
  size        String?
  brand       String?
  category    String?
  images      String   @default("[]") // JSON array of URLs (string for SQLite)
  variants    String   @default("[]") // JSON array of { label, price?, stock? }
  sizes       String   @default("[]") // JSON array of available sizes (XS…XXXL)
  sizeChartUrl String? // uploaded size-chart image
  quantity    Int      @default(1) // one-of-one items default to 1
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  seller     Seller      @relation(fields: [sellerId], references: [id])
  orderItems OrderItem[]

  @@index([sellerId])
}

model Order {
  id               String   @id @default(cuid())
  buyerId          String?
  customerId       String?
  sellerId         String
  buyerName        String?
  buyerPhone       String?
  address          String?
  totalAmount      Int
  itemsAmount      Int
  commissionAmount Int
  shippingCharge   Int
  // PendingPayment | Paid | Accepted | Shipped | Delivered | Completed
  // | Cancelled | Disputed | Refunded
  status           String   @default("PendingPayment")
  razorpayOrderId  String?
  paymentId        String?
  awbNumber        String?
  createdAt        DateTime @default(now())

  buyer  User?       @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller Seller      @relation(fields: [sellerId], references: [id])
  items  OrderItem[]

  @@index([sellerId])
  @@index([buyerId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  title     String
  unitPrice Int
  quantity  Int    @default(1)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Review {
  id          String    @id @default(cuid())
  orderId     String
  productId   String
  sellerId    String
  buyerName   String?
  rating      Int
  comment     String?
  response    String?   // seller's public reply
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([sellerId])
}

model Dispute {
  id          String    @id @default(cuid())
  orderId     String
  sellerId    String
  buyerName   String?
  issueType   String    @default("Not as described")
  description String?
  status      String    @default("open") // open | refunded | released
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status])
}

model Coupon {
  id        String    @id @default(cuid())
  sellerId  String
  code      String
  type      String    @default("percent") // percent | fixed
  value     Int
  minOrder  Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@unique([sellerId, code])
  @@index([sellerId])
}

model Payout {
  id        String   @id @default(cuid())
  sellerId  String
  amount    Int
  status    String   @default("requested") // requested | paid
  createdAt DateTime @default(now())

  @@index([sellerId])
}
