# Copy to .env and fill in. Local dev defaults shown.

# ─── Database (Neon Postgres) ───
# DATABASE_URL = pooled endpoint (host contains "-pooler"), used at runtime.
# DIRECT_URL   = same host WITHOUT "-pooler"; Prisma needs a direct connection
#                for `db push` / `migrate`, which can't run through the pooler.
# Neon Console → Project → Connect → copy the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# ─── Google Sign-In ───
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# ─── Email (Gmail SMTP) — 6-digit shopper signup codes ───
# SMTP_PASS must be a Google APP PASSWORD (16 chars, requires 2-Step
# Verification), never the account password. Leave blank locally and the code
# is returned in the API response instead of being emailed.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

PORT=4000
CORS_ORIGIN="http://localhost:3000"
SHIPPING_FLAT=60

# ─── Platform fee ───
# Orders under COMMISSION_FLAT_BELOW pay a flat COMMISSION_FLAT rupees;
# everything from that amount up pays COMMISSION_PERCENT of the item total.
# Defaults: below ₹100 → ₹5, otherwise 5%.
COMMISSION_PERCENT=5
COMMISSION_FLAT_BELOW=100
COMMISSION_FLAT=5

# External services (stubbed in MVP) — fill in for production
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=

# FamGateway (UPI payments) - server-side only
FAMGATEWAY_API_KEY=
FAMGATEWAY_BASE_URL=https://famgateway.in
# Public URL of this API, used as the payment webhook base (e.g. https://api.loopynow.shop/api/v1)
PUBLIC_API_URL=

# Where the public contact form delivers (defaults to loopynowshopsupport@gmail.com)
SUPPORT_EMAIL=

# ─── Google Analytics (read-only, for the admin Business Intelligence screen) ───
# Separate from the tag on the site (that's NEXT_PUBLIC_GA_ID in the frontend).
# This is server-side access to READ the reports back into the admin console.
#
#  1. Google Cloud Console → enable the "Google Analytics Data API".
#  2. IAM & Admin → Service Accounts → create one → Keys → Add key → JSON.
#  3. Google Analytics → Admin → Property access management → add that service
#     account's email (…@….iam.gserviceaccount.com) with the Viewer role.
#  4. GA_PROPERTY_ID is the NUMERIC id in Admin → Property details — not the
#     measurement id (G-XXXXXXXXXX) and not the stream id.
#
# GA_SERVICE_ACCOUNT_JSON takes the whole key file on one line, or base64 of it
# if the hosting panel mangles the newlines. It can read the entire property,
# so it belongs on the server only — never in a NEXT_PUBLIC_ variable.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_JSON=
