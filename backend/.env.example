# Copy to .env and fill in. Local dev defaults shown.

# ─── Database (Neon Postgres) ───
# DATABASE_URL = pooled endpoint (host contains "-pooler"), used at runtime.
# DIRECT_URL   = same host WITHOUT "-pooler"; Prisma needs a direct connection
#                for `db push` / `migrate`, which can't run through the pooler.
# Neon Console → Project → Connect → copy the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# ─── Google Sign-In ───
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# ─── Email (Gmail SMTP) — 6-digit shopper signup codes ───
# SMTP_PASS must be a Google APP PASSWORD (16 chars, requires 2-Step
# Verification), never the account password. Leave blank locally and the code
# is returned in the API response instead of being emailed.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

PORT=4000
CORS_ORIGIN="http://localhost:3000"
COMMISSION_PERCENT=5
SHIPPING_FLAT=60

# External services (stubbed in MVP) — fill in for production
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
