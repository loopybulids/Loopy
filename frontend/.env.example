# Copy to .env.local for local dev.
# On Vercel, set these in Project → Settings → Environment Variables.
#
# Local dev:        http://localhost:4000/api/v1
# Production: the public URL of your deployed backend, e.g.
#                   https://loopy-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Google Sign-In — OAuth client ID only. This is public (it ships in the browser
# bundle); the client secret belongs in the backend env, never here.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
