# Copy to .env.local for local dev.
# On Vercel, set these in Project → Settings → Environment Variables.
#
# Local dev:        http://localhost:4000/api/v1
# Production: the public URL of your deployed backend, e.g.
#                   https://loopy-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Google Sign-In — OAuth client ID only. This is public (it ships in the browser
# bundle); the client secret belongs in the backend env, never here.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Storefront addressing ───
# Set this and every store gets its own subdomain: cpaybara.loopynow.shop
# instead of loopynow.shop/s/cpaybara. Requires a wildcard domain
# (*.loopynow.shop) pointed at this Vercel project.
#
# Leave it blank locally — localhost has no wildcard, so stores stay on
# /s/<username> and everything keeps working. To try subdomains locally, set it
# to "localhost" and visit cpaybara.localhost:3001 (Chrome resolves this).
NEXT_PUBLIC_ROOT_DOMAIN=loopynow.shop

# ─── Analytics (optional) ───
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank locally:
# nothing loads without it, so development traffic never reaches the property.
# Public pages only — the seller console and admin are excluded in code.
NEXT_PUBLIC_GA_ID=
